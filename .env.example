# Copy to .env (gitignored) and fill in. Loaded by scripts/dev.sh and the other scripts.
# Any mix works. Engines are tried in this order: claude, openai, gemini, ollama
# (CHALK_VISION_PROVIDER moves one to the front); the next is the backup if one fails.

# Paid APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Free options
GEMINI_API_KEY=                        # free tier key from aistudio.google.com
CHALK_OLLAMA_MODEL=                    # local model, e.g. qwen2.5vl:7b (ollama pull qwen2.5vl:7b)

# CHALK_VISION_PROVIDER=ollama         # claude | openai | gemini | ollama
# CHALK_VLM_MODEL=claude-opus-5
# CHALK_OPENAI_MODEL=gpt-5.5
# CHALK_GEMINI_MODEL=gemini-3.8-flash
# CHALK_VISION_FALLBACK=mock           # demo safety net: answer with mock if every model fails
