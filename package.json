{
  "name": "chalk-chain",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "setup:localnet": "bash scripts/setup-localnet.sh",
    "setup:devnet": "bash scripts/setup-devnet.sh",
    "dev": "bash scripts/dev.sh",
    "stop": "bash scripts/stop.sh",
    "e2e": "pnpm --filter @chalk/scripts e2e",
    "test:shared": "pnpm --filter @chalk/shared test",
    "test:all": "pnpm --filter @chalk/shared test && pnpm --filter backend test && pnpm --filter app test && pnpm --filter app build && (cd vision && .venv/bin/python -m pytest -q tests) && (cd program && cargo test)",
    "dev:backend": "pnpm --filter backend dev",
    "dev:app": "pnpm --filter app dev",
    "demo": "bash scripts/demo.sh",
    "demo:cheat": "pnpm --silent --filter @chalk/scripts demo"
  }
}
